# Copie para .env e ajuste os valores. O .env não vai para o git.

# Conexão com o PostgreSQL. Rodando a API fora do Docker, o banco do
# docker-compose fica em localhost:5440.
DATABASE_URL=postgresql+psycopg://cidaderesolve:cidaderesolve@localhost:5440/cidaderesolve

# Chave de assinatura do token JWT (use um valor longo e aleatório, 32+ caracteres).
JWT_SECRET=troque-este-segredo-de-desenvolvimento-local

# Validade do token, em minutos.
JWT_EXPIRA_MINUTOS=60

# Pasta onde as fotos são gravadas.
UPLOAD_DIR=uploads

# Credenciais do gestor criado pela carga inicial.
GESTOR_EMAIL=gestor@cidaderesolve.com
GESTOR_SENHA=gestor12345

# Sites autorizados a chamar a API pelo navegador (front-end), separados por vírgula.
CORS_ORIGENS=http://localhost:5173,http://localhost:3000
