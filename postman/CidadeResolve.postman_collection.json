{
  "info": {
    "name": "CidadeResolve API",
    "description": "Todos os endpoints da CidadeResolve API e um fluxo de demonstração.\n\n1. Importe também o ambiente `CidadeResolve - Local`.\n2. Rode a pasta **Fluxo de demonstração** em ordem (ou pelo Runner): ela preenche sozinha os tokens e os ids usados nas outras pastas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Fluxo de demonstração",
      "item": [
        {
          "name": "01. API no ar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/saude",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "saude"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Registrar cidadão",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "registro"
              ]
            },
            "description": "Gera um e-mail novo a cada execução, para o fluxo poder ser repetido.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Cidadã\",\n  \"email\": \"{{email_cidadao}}\",\n  \"senha\": \"{{senha_cidadao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"email_cidadao\", `cidadao.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Papel é CIDADAO\", () => pm.expect(pm.response.json().papel).to.eql(\"CIDADAO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03. Login do cidadão",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_cidadao}}\",\n  \"senha\": \"{{senha_cidadao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"token_cidadao\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categorias",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categorias"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const categorias = pm.response.json();",
                  "pm.test(\"Há categorias da carga inicial\", () => pm.expect(categorias.length).to.be.above(0));",
                  "pm.environment.set(\"categoria_id\", categorias[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "05. Criar ocorrência",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ocorrencias",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ocorrencias"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cidadao}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Buraco grande na rua\",\n  \"descricao\": \"Há um buraco fundo em frente ao número 120, com risco para motos.\",\n  \"categoria_id\": {{categoria_id}},\n  \"endereco\": \"Rua das Flores, 120\",\n  \"bairro\": \"Centro\",\n  \"latitude\": -23.55052,\n  \"longitude\": -46.633308\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const ocorrencia = pm.response.json();",
                  "pm.test(\"Nasce ABERTA\", () => pm.expect(ocorrencia.status).to.eql(\"ABERTA\"));",
                  "pm.test(\"Não expõe e-mail do autor\", () => pm.expect(ocorrencia.autor).to.not.have.property(\"email\"));",
                  "pm.environment.set(\"ocorrencia_id\", ocorrencia.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06. Enviar foto",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/ocorrencias/{{ocorrencia_id}}/fotos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ocorrencias",
                "{{ocorrencia_id}}",
                "fotos"
              ]
            },
            "description": "No aplicativo Postman, selecione um arquivo JPEG, PNG ou WebP no campo `arquivo` (há um exemplo em `postman/exemplo.png`).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cidadao}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "type": "file",
                  "src": "postman/exemplo.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"foto_id\", pm.response.json().id);",
                  "pm.test(\"Devolve URL completa\", () => pm.expect(pm.response.json().url).to.include(\"/uploads/\"));"
                ]
              }
            }
          ]
        },
